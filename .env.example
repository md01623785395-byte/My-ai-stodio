# MINIMAX_API_KEY: Required for MiniMax Image Generation API calls.
# Configure this in your environment or Secrets panel in AI Studio.
MINIMAX_API_KEY="YOUR_MINIMAX_API_KEY"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# HF_TOKEN: Optional free-tier User Access Token for Hugging Face Serverless Inference.
# Enables free image generation with black-forest-labs/FLUX.1-schnell (Apache-2.0 commercial use).
# Create a free token at https://huggingface.co/settings/tokens (no credit card or billing needed).
HF_TOKEN="YOUR_HF_TOKEN"

# CLOUDFLARE_ACCOUNT_ID & CLOUDFLARE_API_TOKEN: Cloudflare Workers AI Free Tier.
# Provides 10,000 Neurons/day free (~100-150 FLUX.1-schnell images/day) on the Free Plan.
# Apache-2.0 commercial microstock license. Zero paid fallback.
# Find Account ID: Cloudflare Dashboard > Workers & Pages > Overview (right sidebar).
# Create API Token: Cloudflare Dashboard > My Profile > API Tokens > Create Custom Token with "Workers AI: Read".
CLOUDFLARE_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
CLOUDFLARE_API_TOKEN="YOUR_CLOUDFLARE_API_TOKEN"
